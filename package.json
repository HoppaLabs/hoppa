{
  "name": "hoppa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/web/dev-server.ts",
    "build": "bun run tools/build.ts",
    "deploy": "bun run check && bun run build && bun run tools/deploy.ts",
    "cli": "bun run src/cli/index.ts",
    "check:determinism": "bun run tools/check-determinism.ts",
    "check": "bun run check:determinism && bun run check:types && bun test",
    "check:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
